{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id, t.name, t.min_nights, t.benefits, t.color, t.sort_order, t.is_active,\n               COUNT(ul.user_id) AS \"user_count!: i64\"\n        FROM tiers t\n        LEFT JOIN user_loyalty ul ON ul.tier_id = t.id\n        WHERE t.id = $1\n        GROUP BY t.id\n        ",
